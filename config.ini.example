[jquants]
# API キーは ~/.jquants-api/jquants-api.toml から自動読み込み。
# 上書きが必要な場合のみ指定:
# api_key = your_api_key_here

# Plan: free / light / standard / premium
plan = free

# Cache directory (default: ~/.cache/jquants-mcp)
# cache_dir = ~/.cache/jquants-mcp

# API base URL
# base_url = https://api.jquants.com/v2

[client]
# Max retry attempts for failed requests
# max_retries = 5

# Base delay (seconds) for exponential backoff
# retry_base_delay = 1.0

# Max pages per paginated request
# max_pages = 10

# ---------------------------------------------------------------------------
# [server] — multi-user settings.
#
# The server speaks stdio only: there is no TLS, no HTTP listener and no
# built-in authentication to configure here. Remote access is provided by a
# gateway in front of the server (`mcp-stdio serve`), which terminates HTTP
# and OAuth and injects the authenticated identity as JQUANTS_MCP_USER.
# The settings below apply once such a gateway is supplying identities.
# ---------------------------------------------------------------------------
[server]
# AES-256-GCM encryption key for per-user API key storage in multi-user mode (env: MCP_ENCRYPTION_KEY)
# Generate with: python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# encryption_key = your_base64_encoded_32byte_key_here

# Previous encryption key, accepted for decryption during a rotation window
# (env: MCP_ENCRYPTION_KEY_PREVIOUS). Leave empty outside a rotation.
# See docs/runbooks/secrets-rotation.md.
# encryption_key_previous = your_previous_key_here

# Comma-separated emails allowed to sign in (env: JQUANTS_ALLOWED_EMAILS).
# Empty means "allow any authenticated user" (self-host default).
# allowed_emails = you@example.com,family@example.com

# Per-user rate limiting, multi-user mode only
# (env: RATE_LIMIT_PER_MINUTE / RATE_LIMIT_BURST)
# rate_limit_per_minute = 60
# rate_limit_burst = 20

# Let gateway-authenticated users without a registered API key fall back to the
# global client instead of erroring (env: CACHE_BYPASS_AUTH). Intended for
# self-hosted deployments with a pre-populated, read-only cache.db.
# cache_bypass_auth = false

# ---------------------------------------------------------------------------
# GCS (Google Cloud Storage) bulk-download settings — env vars only
# ---------------------------------------------------------------------------
# GCS_BUCKET=your-bucket-name
# GCS_PREFIX=jquants/
# GCS_SYNC_INTERVAL=3600
